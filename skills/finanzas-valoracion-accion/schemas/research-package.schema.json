{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jairoalonso1/agent-skills-factory/blob/main/skills/finanzas-valoracion-accion/schemas/research-package.schema.json",
  "title": "Institutional Equity Research Package",
  "type": "object",
  "required": ["issuer", "valuation_date", "reporting_currency", "financials", "valuation", "scenarios", "risks", "sources"],
  "properties": {
    "issuer": {"type": "string", "minLength": 1},
    "ticker": {"type": "string"},
    "exchange": {"type": "string"},
    "valuation_date": {"type": "string", "format": "date"},
    "current_price": {"type": "number", "exclusiveMinimum": 0},
    "price_timestamp": {"type": "string"},
    "reporting_currency": {"type": "string", "minLength": 3, "maxLength": 3},
    "rating": {"enum": ["BUY / OVERWEIGHT", "HOLD / NEUTRAL", "SELL / UNDERWEIGHT", "NOT_RATED"]},
    "investment_thesis": {"type": "object"},
    "financials": {"type": "object"},
    "industry": {"type": "object"},
    "valuation": {"type": "object"},
    "scenarios": {
      "type": "object",
      "required": ["bear", "base", "bull"],
      "properties": {
        "bear": {"$ref": "#/$defs/scenario"},
        "base": {"$ref": "#/$defs/scenario"},
        "bull": {"$ref": "#/$defs/scenario"}
      },
      "additionalProperties": true
    },
    "risks": {"type": "array"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "assumptions": {"type": "array"},
    "data_gaps": {"type": "array"},
    "artifacts": {"type": "array"}
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "required": ["target_price"],
      "properties": {"target_price": {"type": "number"}, "drivers": {"type": "array"}, "probability": {"type": "number", "minimum": 0, "maximum": 1}},
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": ["source_id", "publisher", "title", "url", "published_at", "retrieved_at", "evidence_type"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "published_at": {"type": "string"},
        "retrieved_at": {"type": "string"},
        "evidence_type": {"enum": ["reported", "company_guidance", "consensus", "analyst_assumption", "calculated", "market_data"]},
        "period": {"type": "string"},
        "notes": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
