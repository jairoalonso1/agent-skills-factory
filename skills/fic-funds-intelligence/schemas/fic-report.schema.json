{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jairoalonso1/agent-skills-factory/blob/main/skills/fic-funds-intelligence/schemas/fic-report.schema.json",
  "title": "FIC Funds Intelligence domain output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "service_id",
    "service_version",
    "operation",
    "status",
    "report_profile",
    "title",
    "funds",
    "summary",
    "metrics",
    "artifacts",
    "evidence",
    "warnings",
    "errors"
  ],
  "properties": {
    "service_id": {
      "const": "fic-funds-intelligence"
    },
    "service_version": {
      "type": "string"
    },
    "operation": {
      "enum": [
        "fund_factsheet",
        "peer_comparison",
        "fund_discovery",
        "category_universe",
        "industry_snapshot",
        "custom_analysis"
      ]
    },
    "status": {
      "enum": [
        "succeeded",
        "partial",
        "needs_input",
        "blocked",
        "failed",
        "cancelled"
      ]
    },
    "report_profile": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "factsheet",
        "comparative",
        null
      ]
    },
    "title": {
      "type": "string"
    },
    "cutoff_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "period_start": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "period_end": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "funds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "codigo_negocio"
        ],
        "properties": {
          "codigo_negocio": {
            "type": "string"
          },
          "nombre": {
            "type": [
              "string",
              "null"
            ]
          },
          "nombre_entidad": {
            "type": [
              "string",
              "null"
            ]
          },
          "codigo_entidad": {
            "type": [
              "string",
              "null"
            ]
          },
          "subtipo_patrimonio": {
            "type": [
              "string",
              "null"
            ]
          },
          "tipo_participacion": {
            "type": [
              "string",
              "null"
            ]
          },
          "categoria_comercial": {
            "type": [
              "string",
              "null"
            ]
          },
          "dimension_categoria": {
            "type": [
              "string",
              "null"
            ]
          },
          "estado_clasificacion": {
            "type": [
              "string",
              "null"
            ]
          },
          "motivo_clasificacion": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "string"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value",
          "unit",
          "period",
          "definition",
          "source"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {},
          "unit": {
            "type": "string"
          },
          "period": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "status": {
            "enum": [
              "reported",
              "calculated",
              "estimated",
              "unavailable"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "category_snapshot": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "cutoff_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "methodology_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "coverage_pct": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "media_type",
          "provenance"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "uri": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "provenance": {
            "enum": [
              "frontera_skaas_generated",
              "user_supplied"
            ]
          },
          "description": {
            "type": "string"
          },
          "brand_identity": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "claim_or_output"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "locator": {
            "type": [
              "string",
              "null"
            ]
          },
          "accessed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "claim_or_output": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "started": {
          "type": "boolean"
        },
        "code_executed": {
          "type": "boolean"
        },
        "network_accessed": {
          "type": "boolean"
        },
        "runtime_mode": {
          "enum": [
            "native_sandbox",
            "local",
            "remote",
            "none"
          ]
        },
        "tools_used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "standard": {
      "type": "object",
      "required": [
        "id",
        "version",
        "profile_version",
        "theme_id",
        "theme_version"
      ],
      "properties": {
        "id": {
          "const": "frontera-fic-reporting"
        },
        "version": {
          "type": "string"
        },
        "profile_version": {
          "type": "string"
        },
        "theme_id": {
          "type": "string"
        },
        "theme_version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "branding": {
      "type": "object",
      "required": [
        "brand_name",
        "logo_status"
      ],
      "properties": {
        "brand_name": {
          "type": "string",
          "minLength": 1
        },
        "logo_status": {
          "enum": [
            "embedded",
            "text_only",
            "not_applicable"
          ]
        },
        "overrides_applied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "conformance": {
      "type": "object",
      "required": [
        "structure",
        "entity_identity",
        "cutoff_and_period",
        "data_provenance",
        "metric_definitions",
        "comparability",
        "placeholder_resolution",
        "html_integrity",
        "reconciliation",
        "visual_inspection"
      ],
      "properties": {
        "structure": {
          "enum": [
            "passed",
            "failed",
            "partial",
            "not_applicable",
            "not_performed"
          ]
        },
        "entity_identity": {
          "enum": [
            "passed",
            "failed",
            "partial",
            "not_applicable",
            "not_performed"
          ]
        },
        "cutoff_and_period": {
          "enum": [
            "passed",
            "failed",
            "partial",
            "not_applicable",
            "not_performed"
          ]
        },
        "data_provenance": {
          "enum": [
            "passed",
            "failed",
            "partial",
            "not_applicable",
            "not_performed"
          ]
        },
        "metric_definitions": {
          "enum": [
            "passed",
            "failed",
            "partial",
            "not_applicable",
            "not_performed"
          ]
        },
        "comparability": {
          "enum": [
            "passed",
            "failed",
            "partial",
            "not_applicable",
            "not_performed"
          ]
        },
        "placeholder_resolution": {
          "enum": [
            "passed",
            "failed",
            "partial",
            "not_applicable",
            "not_performed"
          ]
        },
        "html_integrity": {
          "enum": [
            "passed",
            "failed",
            "partial",
            "not_applicable",
            "not_performed"
          ]
        },
        "reconciliation": {
          "enum": [
            "passed",
            "failed",
            "partial",
            "not_applicable",
            "not_performed"
          ]
        },
        "visual_inspection": {
          "enum": [
            "passed",
            "failed",
            "partial",
            "not_applicable",
            "not_performed"
          ]
        },
        "cross_model_execution": {
          "enum": [
            "passed",
            "failed",
            "partial",
            "not_applicable",
            "not_performed"
          ]
        },
        "domain_review": {
          "enum": [
            "passed",
            "failed",
            "partial",
            "not_applicable",
            "not_performed"
          ]
        }
      },
      "additionalProperties": false
    },
    "execution_profiles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "orchestration",
          "analytical",
          "computational",
          "document",
          "visual_qa"
        ]
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "report_profile": {
            "enum": [
              "factsheet",
              "comparative"
            ]
          }
        },
        "required": [
          "report_profile"
        ]
      },
      "then": {
        "required": [
          "standard",
          "branding",
          "conformance",
          "execution_profiles"
        ]
      }
    }
  ]
}
