{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jairoalonso1/agent-skills-factory/blob/main/schemas/ax-workflow.schema.json",
  "title": "AX Workflow",
  "description": "Portable representation of a person-agent workflow and its state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "workflow_id",
    "title",
    "goal",
    "status",
    "created_at",
    "updated_at",
    "success_criteria",
    "tasks",
    "events"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.0.0"
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "intake",
        "ready",
        "running",
        "waiting_for_user",
        "waiting_for_approval",
        "blocked",
        "in_review",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "requester": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor_type": {
          "enum": [
            "human",
            "system"
          ]
        },
        "display_name": {
          "type": "string"
        },
        "actor_id": {
          "type": "string"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string"
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "type": "string"
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "risk_level": {
          "enum": [
            "low",
            "moderate",
            "high",
            "critical"
          ]
        },
        "autonomy_level": {
          "enum": [
            "suggest",
            "execute_reversible",
            "execute_with_approval",
            "restricted"
          ]
        },
        "source_policy": {
          "type": "string"
        },
        "output_formats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "summary": {
          "type": "string"
        },
        "last_replanned_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "invocations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "invocation_id",
          "skill_id",
          "status"
        ],
        "properties": {
          "invocation_id": {
            "type": "string"
          },
          "skill_id": {
            "type": "string"
          },
          "skill_version": {
            "type": "string"
          },
          "status": {
            "enum": [
              "requested",
              "running",
              "succeeded",
              "partial",
              "needs_input",
              "blocked",
              "failed",
              "cancelled"
            ]
          },
          "result_ref": {
            "type": "string"
          }
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/approval"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkpointed_at": {
          "type": "string",
          "format": "date-time"
        },
        "current_task_id": {
          "type": "string"
        },
        "next_action": {
          "type": "string"
        },
        "resumable": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "locator"
      ],
      "properties": {
        "type": {
          "enum": [
            "url",
            "file",
            "record",
            "artifact",
            "tool_result"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "accessed_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "title",
        "status"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "ready",
            "running",
            "waiting",
            "blocked",
            "succeeded",
            "failed",
            "skipped",
            "cancelled"
          ]
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "assigned_to": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "human",
                "agent",
                "skill",
                "runtime",
                "tool"
              ]
            },
            "id": {
              "type": "string"
            }
          }
        },
        "invocation_id": {
          "type": "string"
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_id",
        "action",
        "status",
        "requested_at"
      ],
      "properties": {
        "approval_id": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected",
            "expired",
            "withdrawn"
          ]
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "decided_by": {
          "type": "string"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "name",
        "media_type"
      ],
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "checksum": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "type",
        "occurred_at",
        "actor",
        "summary"
      ],
      "properties": {
        "event_id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "actor": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "payload": {
          "type": "object"
        }
      }
    }
  }
}
