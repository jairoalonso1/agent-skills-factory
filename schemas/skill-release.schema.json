{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jairoalonso1/agent-skills-factory/blob/main/schemas/skill-release.schema.json",
  "title": "Skill Release Governance Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "entrypoint",
    "release_status",
    "capabilities",
    "dependencies",
    "data_dependencies",
    "evaluation",
    "runtime_compatibility"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\\\d*)\\\\.(0|[1-9]\\\\d*)\\\\.(0|[1-9]\\\\d*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "release_status": {
      "enum": [
        "draft",
        "candidate",
        "validated",
        "runtime-tested",
        "evaluated",
        "managed-service",
        "deprecated"
      ]
    },
    "release_ref": {
      "type": "string",
      "description": "Immutable tag, commit or content digest for this release."
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version_constraint"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version_constraint": {
            "type": "string"
          },
          "optional": {
            "type": "boolean"
          }
        }
      }
    },
    "data_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "access_mode",
          "license_status",
          "freshness"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "access_mode": {
            "enum": [
              "user-supplied",
              "public",
              "licensed",
              "proprietary",
              "unknown"
            ]
          },
          "license_status": {
            "enum": [
              "verified",
              "user-responsibility",
              "pending",
              "not-applicable"
            ]
          },
          "freshness": {
            "type": "string"
          },
          "coverage": {
            "type": "string"
          },
          "provenance_required": {
            "type": "boolean"
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "not-run",
            "in-progress",
            "passed",
            "failed",
            "partial"
          ]
        },
        "suite_ref": {
          "type": "string"
        },
        "suite_version": {
          "type": "string"
        },
        "last_run": {
          "type": "string",
          "format": "date-time"
        },
        "environment": {
          "type": "string"
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "string",
              "boolean"
            ]
          }
        },
        "report_ref": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "runtime_compatibility": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "host",
          "surface",
          "status"
        ],
        "properties": {
          "host": {
            "type": "string"
          },
          "surface": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "status": {
            "enum": [
              "documented",
              "declared",
              "tested",
              "not-tested",
              "failed"
            ]
          },
          "tested_at": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_ref": {
            "type": "string"
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string"
        },
        "support_contact": {
          "type": "string"
        },
        "support_policy_ref": {
          "type": "string"
        },
        "service_objectives_ref": {
          "type": "string"
        },
        "accountability_scope": {
          "type": "string"
        }
      }
    },
    "commercial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "availability": {
          "enum": [
            "not-offered",
            "quote-only",
            "public"
          ]
        },
        "pricing_model": {
          "enum": [
            "per-invocation",
            "usage",
            "subscription",
            "managed-runtime",
            "licensed-data",
            "enterprise-contract"
          ]
        },
        "price_ref": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        }
      }
    }
  }
}
